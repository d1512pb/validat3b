# Copia este archivo a .env (está en .gitignore) y llena la llave.
# La llave del equipo es personal: no se comparte ni se sube al repositorio.
ANTHROPIC_API_KEY=
# Opcional, si la llave pertenece a un espacio de trabajo:
ANTHROPIC_WORKSPACE_ID=
FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=https://softwaredevelopment-resource.services.ai.azure.com/anthropic
MODELO_RAPIDO=claude-haiku-5-5-pensar
MODELO_FUERTE=claude-haiku-5-5-pensar
ESCALAR_A_FUERTE=false
VERIFICAR_APROBACIONES=false

# real | simulado (simulado responde sin gastar tokens)
MODO=real

# Umbrales: por defecto se usan los calibrados de modelos/. Aprobar si p_aprobar >= UMBRAL_APROBAR; rechazar si p_rechazo >= UMBRAL_P_RECHAZO
# UMBRAL_APROBAR=0.95
# UMBRAL_P_RECHAZO=0.67

# Si se define, la app manda el header X-API-Key con este valor
SERVIDOR_TOKEN=
