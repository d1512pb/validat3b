{
  "openapi": "3.1.0",
  "info": {
    "title": "Validat3B",
    "description": "Valida capturas de precio en campo: aprobada, rechazada o revision_manual, con motivo y confianza.",
    "version": "0.3.0"
  },
  "paths": {
    "/salud": {
      "get": {
        "tags": [
          "servicio"
        ],
        "summary": "Salud",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Salud Salud Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capturas": {
      "post": {
        "tags": [
          "capturas"
        ],
        "summary": "Valida una captura (multipart: campo captura + 3 fotos)",
        "operationId": "validar_captura_v1_capturas_post",
        "parameters": [
          {
            "name": "modo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "real",
                    "simulado"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "'simulado' responde sin gastar IA.",
              "title": "Modo"
            },
            "description": "'simulado' responde sin gastar IA."
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_validar_captura_v1_capturas_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaCaptura"
                }
              }
            }
          },
          "400": {
            "description": "Captura o fotos inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "401": {
            "description": "Falta o no coincide X-API-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "413": {
            "description": "Una foto excede el tamaño máximo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de imagen no soportado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "La petición no cumple el contrato.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_validar_captura_v1_capturas_post": {
        "properties": {
          "captura": {
            "type": "string",
            "title": "Captura",
            "description": "CapturaEntrada en JSON (ver contratos/captura_entrada.schema.json)."
          },
          "foto_fachada": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Foto Fachada"
          },
          "foto_producto": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Foto Producto"
          },
          "foto_etiqueta": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Foto Etiqueta"
          }
        },
        "type": "object",
        "required": [
          "captura"
        ],
        "title": "Body_validar_captura_v1_capturas_post"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "aprobada",
          "rechazada",
          "revision_manual"
        ],
        "title": "Decision"
      },
      "DetalleError": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo",
            "examples": [
              "FOTO_INVALIDA"
            ]
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          },
          "detalles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Detalles"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "DetalleError"
      },
      "ErrorRespuesta": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/DetalleError"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorRespuesta"
      },
      "Estado": {
        "type": "string",
        "enum": [
          "ok",
          "falla"
        ],
        "title": "Estado"
      },
      "RespuestaCaptura": {
        "properties": {
          "capture_id": {
            "type": "string",
            "title": "Capture Id"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code",
            "description": "null cuando la captura se aprueba."
          },
          "validaciones": {
            "$ref": "#/components/schemas/Validaciones"
          },
          "precio_detectado": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio Detectado"
          },
          "codigo_barras_detectado": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codigo Barras Detectado"
          },
          "explicacion": {
            "type": "string",
            "title": "Explicacion"
          },
          "traza": {
            "$ref": "#/components/schemas/Traza"
          }
        },
        "type": "object",
        "required": [
          "capture_id",
          "decision",
          "confidence_score",
          "validaciones",
          "explicacion",
          "traza"
        ],
        "title": "RespuestaCaptura"
      },
      "Traza": {
        "properties": {
          "version_motor": {
            "type": "string",
            "title": "Version Motor"
          },
          "version_contrato": {
            "type": "string",
            "title": "Version Contrato",
            "default": "0.3.0"
          },
          "capa_decisiva": {
            "type": "string",
            "enum": [
              "local",
              "rapido",
              "fuerte",
              "respaldo",
              "simulado"
            ],
            "title": "Capa Decisiva",
            "description": "Qué capa tomó la decisión: chequeos locales, modelo rápido (Haiku), fuerte (Sonnet), respaldo por error o simulado."
          },
          "modelos_usados": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Modelos Usados"
          },
          "tokens_entrada": {
            "type": "integer",
            "title": "Tokens Entrada",
            "default": 0
          },
          "tokens_salida": {
            "type": "integer",
            "title": "Tokens Salida",
            "default": 0
          },
          "latencia_ms": {
            "type": "integer",
            "title": "Latencia Ms",
            "default": 0
          },
          "tipo_precio": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "regular",
                  "oferta",
                  "volumen",
                  "desconocido"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tipo Precio"
          },
          "precio_unitario_detectado": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio Unitario Detectado"
          },
          "promocion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promocion",
            "description": "Texto de la promoción si la hay, p. ej. '2x$50'."
          },
          "precio_regular": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio Regular",
            "description": "Precio normal que muestra la etiqueta."
          },
          "precio_promocion": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precio Promocion",
            "description": "Precio con descuento por pieza, si lo hay."
          },
          "compuertas_fallidas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Compuertas Fallidas",
            "description": "Por qué no se aprobó: cada compuerta que no pasó (p. ej. 'precio_coincide: ...'). Vacía si todo pasó."
          },
          "doble_verificacion": {
            "type": "boolean",
            "title": "Doble Verificacion",
            "description": "True si la aprobación se confirmó con el modelo fuerte.",
            "default": false
          },
          "avisos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Avisos",
            "description": "Mensajes cortos para el capturista."
          }
        },
        "type": "object",
        "required": [
          "version_motor",
          "capa_decisiva"
        ],
        "title": "Traza",
        "description": "Datos extra para auditar y para la app. No van al archivo oficial."
      },
      "Validaciones": {
        "properties": {
          "tienda_fachada": {
            "$ref": "#/components/schemas/Estado"
          },
          "producto": {
            "$ref": "#/components/schemas/Estado"
          },
          "codigo_barras": {
            "$ref": "#/components/schemas/Estado"
          },
          "evidencia_precio": {
            "$ref": "#/components/schemas/Estado"
          }
        },
        "type": "object",
        "required": [
          "tienda_fachada",
          "producto",
          "codigo_barras",
          "evidencia_precio"
        ],
        "title": "Validaciones"
      }
    }
  }
}
